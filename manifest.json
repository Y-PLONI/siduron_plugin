{
  "schemaVersion": 1,
  "id": "com.moshenahari.siduron",
  "name": "סידורון",
  "version": "4.0.0",
  "description": "סידור חכם",
  "author": "y.pl",
  "homepage": "https://github.com/Y-PLONI/siduron_plugin",
  "entrypoint": "index.html",
  "icon": "icon/icon.png",
  "stability": "beta",
  "minAppVersion": "0.9.98.1",
  "sdkVersion": "1.x",
  "permissions": [
    "calendar.read",
    "settings.read",
    "library.content.read",
    "ui.create_shortcut",
    "plugin.open_other",
    "events.subscribe:settings.changed"
  ],
  "network": {
    "enabled": false,
    "allowlist": []
  },
  "contributes": {
    "toolTab": {
      "title": "סידורון",
      "order": 300,
      "defaultPinned": true,
      "iconName": "book_open_24_regular"
    }
  }
}
